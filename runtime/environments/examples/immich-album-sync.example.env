# Deploy to /etc/homelab/immich-album-sync.env (root:root, mode 0600).
# IMMICH_LIBRARY_ID is shown in the Immich admin Libraries page after creation.
IMMICH_URL=http://100.64.0.10:2283/api
IMMICH_API_KEY=CHANGE_ME_IMMICH_API_KEY
IMMICH_LIBRARY_ID=CHANGE_ME_EXTERNAL_LIBRARY_ID
IMMICH_ALBUM_NAME='Example Album'
