# Deploy to /etc/homelab/databases.env  (root:root, mode 0600)
#
# Consumed by: runtime/compose/databases/docker-compose.yml (postgres)
# Never commit the live file. Placeholders only in Git.

# Superuser for the shared PostgreSQL instance.
POSTGRES_USER=homelab_admin
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
POSTGRES_DB=homelab

# Least-privilege role owned by Nextcloud. Created by
# operations/bootstrap/40-database-roles.sh; the value must match nextcloud.env.
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGE_ME_NEXTCLOUD_DB_PASSWORD
