# Deploy to /etc/homelab/immich.env  (root:root, mode 0600)
#
# Consumed by: runtime/compose/immich/docker-compose.yml
#
# Immich runs its OWN PostgreSQL, deliberately. It requires the VectorChord and
# pgvector extensions, which the shared homelab-postgres image does not provide at
# all, and it pins PostgreSQL 14 while the shared instance runs 18. Sharing would
# tie Nextcloud's upgrade schedule to Immich's in both directions.

DB_USERNAME=immich
DB_PASSWORD=CHANGE_ME
DB_DATABASE_NAME=immich
