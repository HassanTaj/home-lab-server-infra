# Deploy to /etc/homelab/backup.env  (root:root, mode 0600)
#
# Consumed by: operations/backups/*.sh and operations/restore/*.sh
# Losing RESTIC_PASSWORD_* makes the matching repository unrecoverable.
# Store both passwords in an offline password manager as well.

# --- Repository location ---------------------------------------------------
# Internal application/config/data + database dumps -> encrypted Restic on the data disk.
#
# There is deliberately NO backup of the complete data disk itself: its
# existing archive/media content remains outside the pool and is unbacked.
# Protected SSD datasets, including shared-internal and Immich managed originals,
# are backed up by backup-internal-to-disk.sh.
RESTIC_REPO_INTERNAL=/mnt/data/.homelab/backups/internal
RESTIC_PASSWORD_INTERNAL=CHANGE_ME_RESTIC_INTERNAL_PASSWORD

# --- Retention ------------------------------------------------------------
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=6

# --- Safety ---------------------------------------------------------------
# The data filesystem UUID that every job verifies before doing any work.
DATA_UUID=DEMO_DATA_DISK_UUID
