# Deploy to /etc/homelab/beszel.env  (root:root, mode 0600)
#
# Consumed by: operations/monitoring/systemd/beszel-agent.service
#
# The hub runs on EDGE_VPS (beszel.example.com). This host runs the agent
# only, in the same pull model the hub's own agent uses: the agent listens, the
# hub dials in and authenticates with its public key.

# NetBird address only. Never 0.0.0.0 — the agent exposes host and container
# metrics, and left unset it binds every interface including the LAN.
LISTEN=100.64.0.10:45876

# The HUB's public key, shown by the hub when adding a system. Not a secret, and
# not a "token": the agent refuses to start without it.
KEY=CHANGE_ME_HUB_PUBLIC_KEY
