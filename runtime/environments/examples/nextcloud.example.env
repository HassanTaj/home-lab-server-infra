# Deploy to /etc/homelab/nextcloud.env  (root:root, mode 0600)
#
# Consumed by: runtime/compose/nextcloud/docker-compose.yml (nextcloud, cron)
# Never commit the live file.

# --- Database -------------------------------------------------------------
# POSTGRES_HOST is set in the Compose file, not here.
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME_NEXTCLOUD_DB_PASSWORD

# --- Initial administrator -----------------------------------------------
# Used only on first installation. Safe to leave in place afterwards.
NEXTCLOUD_ADMIN_USER=CHANGE_ME_ADMIN_USER
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Redis locking --------------------------------------------------------
# REDIS_HOST is set in the Compose file. Must match redis.env.
REDIS_HOST_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Reverse proxy --------------------------------------------------------
# The edge VPS Traefik peer address on the NetBird overlay. Confirm the real
# value with operations/tests/check-edge-vps-peer.sh before deploying; an
# over-broad value here weakens Nextcloud's proxy trust.
TRUSTED_PROXIES=CHANGE_ME_EDGE_VPS_NETBIRD_IP
APACHE_DISABLE_REWRITE_IP=1

# --- SMTP (password reset and recovery) -----------------------------------
# Same mxrouting mailbox the edge VPS Zitadel / Vaultwarden / Kener stacks use.
# Implicit TLS on 465, so SMTP_SECURE=ssl (the image maps this to
# mail_smtpsecure). Source: Refference/edge-vps-server-setup vaultwarden and
# zitadel stacks.
#
# Without this, "forgot password" silently does nothing and a user who loses
# their password can only be recovered by an admin reset through occ.
SMTP_HOST=fusion.mxrouting.net
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTHTYPE=LOGIN
SMTP_NAME=no-reply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# Sender identity. These combine into the From header, giving
# no-reply@example.com.
MAIL_FROM_ADDRESS=no-reply
MAIL_DOMAIN=example.com

# DELIVERABILITY WARNING: example.com has SPF and DKIM, but the edge VPS
# docs record a MISSING DMARC record, which caused consumer Outlook/Hotmail to
# silently filter mail from this domain (Gmail delivery works). Add DMARC
# before relying on password-reset mail reaching Outlook addresses.
